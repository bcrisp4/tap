		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@tanstack/query-async-storage-persister": "^5.100.5",
		"@tanstack/query-persist-client-core": "^5.100.5",
